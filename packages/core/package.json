{
  "name": "@cues/sawdust",
  "version": "0.1.0",
  "description": "Runtime-agnostic logging toolkit built on LogLayer — Node and browser console/consola/pretty transports, request-scoped context, and structured error serialization. Datadog logs/RUM/APM live in @cues/sawdust-datadog.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catesandrew/sawdust.git",
    "directory": "packages/core"
  },
  "homepage": "https://catesandrew.github.io/sawdust/",
  "bugs": "https://github.com/catesandrew/sawdust/issues",
  "keywords": [
    "logging",
    "logger",
    "loglayer",
    "typescript",
    "observability",
    "structured-logging",
    "nodejs",
    "browser"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/cjs/types/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "require": "./dist/cjs/types/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "browser": "./dist/*.web.js",
      "node": {
        "import": "./dist/*.node.js",
        "require": "./dist/cjs/*.node.js"
      },
      "import": "./dist/*.js",
      "require": "./dist/cjs/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/cjs/tsconfig.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ./scripts/postbuild-cjs.mjs",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@loglayer/plugin": "^2.1.6",
    "@loglayer/shared": "^2.5.3",
    "@loglayer/transport": "^2.3.4",
    "@loglayer/transport-consola": "^2.1.7",
    "@loglayer/transport-simple-pretty-terminal": "^2.2.8",
    "client-only": "^0.0.1",
    "consola": "^3.4.2",
    "loglayer": "^6.9.1",
    "serialize-error": "^12.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^20.14.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
